# Appwrite Cloud
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_DATABASE_ID=cremiro
APPWRITE_PROFILES_TABLE_ID=profiles
APPWRITE_REQUESTS_TABLE_ID=requests
APPWRITE_JOB_ITEMS_TABLE_ID=job_items
APPWRITE_CREDIT_TRANSACTIONS_TABLE_ID=credit_transactions
APPWRITE_MEDIA_BUCKET_ID=media
APPWRITE_CONTENT_WORKER_FUNCTION_ID=content-worker

# Server-only Appwrite API key. Never expose this to the browser.
APPWRITE_API_KEY=your-server-api-key

# OpenRouter AI (server-only)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=your-low-cost-image-model
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Cremiro

# Site URL used for Appwrite auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# External product services retained by Cremiro.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key
PEXELS_API_KEY=your-pexels-api-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional server-side Turnstile validation secret.
TURNSTILE_SECRET_KEY=your-turnstile-secret

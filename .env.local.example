# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile CAPTCHA
# 1. Sign up at https://dash.cloudflare.com and go to Turnstile
# 2. Create a site and copy the Site Key (public) and Secret Key (private)
# 3. In Supabase Dashboard → Auth → Settings → Bot and Abuse Protection:
#    Enable CAPTCHA, select "Cloudflare Turnstile", paste the Secret Key
# 4. Add localhost to your Turnstile domain allowlist for local dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Note: To enable Google OAuth:
# 1. Go to your Supabase project dashboard
# 2. Navigate to Authentication > Providers
# 3. Enable Google provider
# 4. Add your Google OAuth Client ID and Secret
# 5. Set redirect URL to: https://your-project-ref.supabase.co/auth/v1/callback
# 6. Add authorized redirect URIs in Google Cloud Console:
#    - https://your-project-ref.supabase.co/auth/v1/callback
#    - http://localhost:3000/auth/callback (for development)

